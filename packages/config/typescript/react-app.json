{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "DreamFive — aplicación React (TanStack Start + Vite)",
  "extends": "./base.json",
  "compilerOptions": {
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": false
  }
}
