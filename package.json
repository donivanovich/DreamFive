{
  "name": "dream5",
  "version": "0.1.0",
  "private": true,
  "description": "DREAM5 — juego de gestión deportiva fantasy de baloncesto (monorepo)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=12.18.0 <13"
  },
  "scripts": {
    "build": "pnpm -r --sort run build",
    "build:packages": "pnpm --filter \"./packages/**\" --sort run build",
    "build:web": "pnpm --filter @dream5/web... --sort run build",
    "build:api": "pnpm --filter @dream5/api... --sort run build",
    "build:worker": "pnpm --filter @dream5/worker... --sort run build",
    "dev:web": "pnpm --filter @dream5/web run dev",
    "dev:api": "pnpm --filter @dream5/api run dev",
    "dev:worker": "pnpm --filter @dream5/worker run dev",
    "typecheck": "pnpm run build:packages && pnpm -r --sort run typecheck",
    "lint": "pnpm run build:packages && eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build:packages && pnpm -r --sort run test",
    "test:e2e": "pnpm --filter @dream5/web run test:e2e",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "db:generate": "pnpm --filter @dream5/database run db:generate",
    "db:validate": "pnpm --filter @dream5/database run db:validate",
    "db:migrate:dev": "pnpm --filter @dream5/database run db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @dream5/database run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter @dream5/database run db:migrate:status",
    "db:studio": "pnpm --filter @dream5/database run db:studio",
    "db:seed": "pnpm --filter @dream5/database run build && pnpm --filter @dream5/database run db:seed",
    "docker:config": "docker compose config --quiet",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f",
    "docker:infra": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d postgres redis",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:seed": "docker compose run --rm seed",
    "audit": "pnpm audit",
    "audit:prod": "pnpm audit --prod"
  },
  "devDependencies": {
    "@dream5/config": "workspace:*",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "catalog:"
  }
}
