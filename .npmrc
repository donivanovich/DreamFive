# pnpm >= 11 lee su configuración desde pnpm-workspace.yaml.
# Este archivo se reserva para ajustes compatibles con npm (registro y
# autenticación). NUNCA guardes aquí tokens: usa variables de entorno,
# por ejemplo //registry.npmjs.org/:_authToken=${NPM_TOKEN}
registry=https://registry.npmjs.org/
engine-strict=true
