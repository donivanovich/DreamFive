{
  "name": "@dreamfive/web",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación web de DreamFive (TanStack Start + React + Tailwind CSS v4 + shadcn/ui)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "srvx --prod -s ../client dist/server/server.js",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@dreamfive/shared": "workspace:*",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.5",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "srvx": "1.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@dreamfive/config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "catalog:",
    "vite": "8.3.8",
    "vitest": "catalog:"
  }
}
