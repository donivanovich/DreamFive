# =============================================================================
# DreamFive — variables de entorno
# =============================================================================
# 1. Copia este archivo:  Copy-Item .env.example .env
# 2. Sustituye TODOS los valores "change-me" por secretos generados, p. ej.:
#      node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 3. NUNCA subas .env al repositorio (está excluido en .gitignore).
#
# Los valores de este archivo son ejemplos NO sensibles para desarrollo local.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# --- PostgreSQL (contenedor) -----------------------------------------------------
POSTGRES_USER=dreamfive
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=dreamfive
# Puerto publicado en 127.0.0.1 solo con docker-compose.dev.yml
POSTGRES_PORT=5432
# Rango de respaldo en Docker si POSTGRES_PORT ya está en uso
POSTGRES_PORT_RANGE=5432-5499

# Cadena de conexión usada por Prisma, la API y el worker al ejecutarse en el
# host. En Docker Compose se construye automáticamente.
DATABASE_URL=postgresql://dreamfive:change-me-postgres-password@localhost:5432/dreamfive?schema=public
DATABASE_POOL_MAX=10

# --- Redis (contenedor) ----------------------------------------------------------
REDIS_HOST=localhost
# Puerto publicado en 127.0.0.1 solo con docker-compose.dev.yml
REDIS_PORT=6379
# Rango de respaldo en Docker si REDIS_PORT ya está en uso
REDIS_PORT_RANGE=6379-6449
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
# Prefijo de las claves de BullMQ en Redis
QUEUE_PREFIX=dreamfive

# --- API (NestJS + Fastify) -------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=3001
# Rango de respaldo en Docker si API_PORT ya está en uso
API_PORT_RANGE=3001-3099
# Lista separada por comas de orígenes permitidos (sin comodines ni rutas)
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true solo si la API está detrás de un proxy inverso de confianza
API_TRUST_PROXY=false
# Swagger UI en /docs. Prohibido en producción (la API no arranca).
API_SWAGGER_ENABLED=true
# Duración de sesión local (en horas) y nombre de cookie HttpOnly
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME=dreamfive_session
# Herramientas de simulación acelerada y administración dev. Prohibido en producción.
DEV_TOOLS_ENABLED=true
# Límite básico de peticiones en rutas sensibles
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Worker -------------------------------------------------------------------------
# Archivo de latido para el health check (por defecto en el directorio temporal)
# WORKER_HEARTBEAT_FILE=/tmp/dreamfive-worker.heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Frecuencia del planificador 24/7 en ms (por defecto 5000 ms en local)
WORKER_SCHEDULER_INTERVAL_MS=5000
TZ=Europe/Madrid

# --- Web (TanStack Start) ---------------------------------------------------------
WEB_PORT=3000
# Rango de respaldo en Docker si WEB_PORT ya está en uso
WEB_PORT_RANGE=3000-3099
# PÚBLICA: se incrusta en el código del navegador. Nunca pongas secretos en VITE_*
VITE_API_URL=http://localhost:3001
# URL pública base para metadatos al compartir enlaces (Open Graph / Twitter Cards)
VITE_PUBLIC_URL=http://localhost:3000
# Solo afecta al banner/herramientas de prueba en desarrollo
VITE_DEV_TOOLS_ENABLED=true

# --- Correo SMTP real (Gmail con contraseña de aplicación / Resend / Brevo) ---
# Ajusta WEB_PUBLIC_URL al puerto real donde abres la web (p. ej. http://localhost:3100 si WEB_PORT=3100).
WEB_PUBLIC_URL=http://localhost:3000
# Para Gmail, genera una Contraseña de Aplicación (16 caracteres) en tu cuenta Google:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASS=tu-app-password-de-16-caracteres
#   SMTP_FROM=DreamFive <tu-correo@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DreamFive <no-reply@dreamfive.local>
UPLOAD_DIR=/app/uploads
