# =============================================================================
# DreamFive — variables de entorno
# =============================================================================
# 1. Copia este archivo:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# 2. Sustituye TODOS los valores "change-me" por secretos generados, p. ej.:
#      node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 3. NUNCA subas `.env` al repositorio (excluido en `.gitignore` y `.dockerignore`).
#
# Los valores de este archivo son ejemplos NO sensibles para entorno local.
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug
TZ=Europe/Madrid

# --- Gateway Nginx (único puerto publicado en Docker) ------------------------
# En producción (Raspberry Pi 5), Cloudflare Tunnel apunta:
#   dreamfive.donivanovich.dev -> http://localhost:3000
GATEWAY_PORT=3000
# Rango de respaldo en Docker local (`docker-compose.yml` / `pnpm docker:up`) si 3000 está ocupado
GATEWAY_PORT_RANGE=3000-3099

# --- Imágenes GHCR (solo para `docker-compose.prod.yml` en Raspberry Pi 5) ---
GHCR_IMAGE_PREFIX=ghcr.io/donivanovich/dreamfive
IMAGE_TAG=main

# --- PostgreSQL (red interna `backend`) --------------------------------------
POSTGRES_USER=dreamfive
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=dreamfive
# Puerto publicado en 127.0.0.1 SOLO con docker-compose.dev.yml (desarrollo en host)
POSTGRES_PORT=5432
POSTGRES_PORT_RANGE=5432-5499

# Cadena de conexión usada por Prisma, API y worker al ejecutarse en el host.
# En Docker Compose se construye automáticamente contra `postgres:5432`.
DATABASE_URL=postgresql://dreamfive:change-me-postgres-password@localhost:5432/dreamfive?schema=public
DATABASE_POOL_MAX=10

# --- Redis (red interna `backend`) -------------------------------------------
REDIS_HOST=localhost
# Puerto publicado en 127.0.0.1 SOLO con docker-compose.dev.yml (desarrollo en host)
REDIS_PORT=6379
REDIS_PORT_RANGE=6379-6449
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0
# Prefijo de las claves de BullMQ en Redis
QUEUE_PREFIX=dreamfive

# --- API (NestJS + Fastify — interna en Docker, puerto 3001) -----------------
API_HOST=0.0.0.0
API_PORT=3001
# Lista separada por comas de orígenes permitidos (sin comodines ni rutas).
# En producción con Cloudflare Tunnel: https://dreamfive.donivanovich.dev
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# true detrás del gateway Nginx / Cloudflare Tunnel
API_TRUST_PROXY=true
# Swagger UI en /docs. Prohibido en producción (la API aborta el arranque si es true).
API_SWAGGER_ENABLED=true
# Duración de sesión local (en horas) y nombre de cookie HttpOnly
AUTH_SESSION_TTL_HOURS=168
AUTH_COOKIE_NAME=dreamfive_session
# Herramientas de simulación acelerada y administración dev. Prohibido en producción.
DEV_TOOLS_ENABLED=true
# Límite básico de peticiones en rutas sensibles
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# --- Worker (red interna `backend`) ------------------------------------------
# Archivo de latido para el health check (por defecto /tmp/worker.heartbeat en Docker)
# WORKER_HEARTBEAT_FILE=/tmp/dreamfive-worker.heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=10000
# Frecuencia del planificador 24/7 en ms
WORKER_SCHEDULER_INTERVAL_MS=5000

# --- Web (TanStack Start — interna en Docker, puerto 3000) -------------------
# Puerto de `pnpm dev:web` cuando se ejecuta fuera de Docker
WEB_PORT=3000
# PÚBLICA: se incrusta en el código del navegador. Nunca pongas secretos en VITE_*.
# Con gateway Nginx (Docker / producción): usa ruta relativa `/api` (mismo dominio).
# Sin gateway (ejecutando `pnpm dev:api` y `pnpm dev:web` directo en host): http://localhost:3001
VITE_API_URL=/api
# URL pública base para metadatos al compartir enlaces (Open Graph / Twitter Cards)
# En producción: https://dreamfive.donivanovich.dev
VITE_PUBLIC_URL=http://localhost:3000
# Solo afecta al banner/herramientas de prueba en desarrollo
VITE_DEV_TOOLS_ENABLED=false

# --- URL pública y correo SMTP real (Gmail App Password / Resend / Brevo) ----
# En producción: https://dreamfive.donivanovich.dev
WEB_PUBLIC_URL=http://localhost:3000
# Para Gmail, genera una Contraseña de Aplicación (16 caracteres) en tu cuenta Google:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=tu-correo@gmail.com
#   SMTP_PASS=tu-app-password-de-16-caracteres
#   SMTP_FROM=DreamFive <tu-correo@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DreamFive <no-reply@dreamfive.local>
UPLOAD_DIR=/app/uploads
